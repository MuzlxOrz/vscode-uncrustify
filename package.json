{
    "name": "uncrustify-plus",
    "displayName": "Uncrustify+",
    "description": "Code format using uncrustify",
    "version": "4.0.0",
    "publisher": "MuzlxOrz",
    "license": "MIT",
    "homepage": "https://github.com/MuzlxOrz/vscode-uncrustify",
    "icon": "images/uncrustify.png",
    "galleryBanner": {
        "color": "#1F1F1F",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/MuzlxOrz/vscode-uncrustify.git"
    },
    "bugs": {
        "url": "https://github.com/MuzlxOrz/vscode-uncrustify/issues"
    },
    "engines": {
        "vscode": "^1.114.0"
    },
    "categories": [
        "Formatters"
    ],
    "keywords": [
        "uncrustify",
        "format",
        "formatting",
        "formatter",
        "multi-root ready"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension",
    "contributes": {
        "configuration": {
            "title": "Uncrustify+",
            "properties": {
                "uncrustify-plus.executablePath.linux": {
                    "type": "string",
                    "default": "uncrustify",
                    "description": "Uncrustify executable name or path",
                    "scope": "window"
                },
                "uncrustify-plus.executablePath.osx": {
                    "type": "string",
                    "default": "uncrustify",
                    "description": "Uncrustify executable name or path (macOS)",
                    "scope": "window"
                },
                "uncrustify-plus.executablePath.windows": {
                    "type": "string",
                    "default": "uncrustify.exe",
                    "description": "Uncrustify executable name or path (Windows)",
                    "scope": "window"
                },
                "uncrustify-plus.configPath.linux": {
                    "type": "string",
                    "default": "uncrustify.cfg",
                    "description": "Path to the uncrustify configuration file relative to the workspace root (Linux)",
                    "scope": "resource"
                },
                "uncrustify-plus.configPath.osx": {
                    "type": "string",
                    "default": "uncrustify.cfg",
                    "description": "Path to the uncrustify configuration file relative to the workspace root (macOS)",
                    "scope": "resource"
                },
                "uncrustify-plus.configPath.windows": {
                    "type": "string",
                    "default": "uncrustify.cfg",
                    "description": "Path to the uncrustify configuration file relative to the workspace root (Windows)",
                    "scope": "resource"
                },
                "uncrustify-plus.configPathOverrides": {
                    "type": "object",
                    "default": {},
                    "description": "Overrides default config path settings for uncrustify. Can be used to support multi-root workspaces",
                    "scope": "resource"
                },
                "uncrustify-plus.include": {
                    "type": "array",
                    "default": [
                        "**/*"
                    ],
                    "description": "List of files or directories to include in formatting",
                    "scope": "resource"
                },
                "uncrustify-plus.exclude": {
                    "type": "array",
                    "default": [],
                    "description": "List of files or directories to exclude from formatting",
                    "scope": "resource"
                },
                "uncrustify-plus.debug": {
                    "type": "boolean",
                    "default": false,
                    "description": "Toggles logging for debugging the extension",
                    "scope": "window"
                },
                "uncrustify-plus.langOverrides": {
                    "type": "object",
                    "default": {
                        "apex": "JAVA",
                        "apex-anon": "JAVA"
                    },
                    "description": "Overrides default language settings for uncrustify. Can be used to support languages not officially supported",
                    "scope": "window"
                },
                "uncrustify-plus.useTempFile": {
                    "type": "boolean",
                    "default": true,
                    "description": "Uses a temporary file to bypass VSCode's document handling",
                    "scope": "resource"
                }
            }
        },
        "commands": [
            {
                "title": "Create default config file",
                "category": "Uncrustify+",
                "command": "uncrustify-plus.create"
            },
            {
                "title": "Open config file",
                "category": "Uncrustify+",
                "command": "uncrustify-plus.open"
            },
            {
                "title": "Upgrade config file",
                "category": "Uncrustify+",
                "command": "uncrustify-plus.upgrade"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "lint": "eslint .",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run lint && npm run compile",
        "test": "node ./out/test/runTest.js"
    },
    "dependencies": {
        "fs-extra": "^11.4.1",
        "minimatch": "^10.2.6",
        "temp": "^0.9.4"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@types/fs-extra": "^11.0.4",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.3",
        "@types/temp": "^0.9.4",
        "@types/vscode": "^1.114.0",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "eslint": "^10.13.0",
        "glob": "^13.0.6",
        "mocha": "^12.0.3",
        "typescript": "^6.0.3"
    }
}
